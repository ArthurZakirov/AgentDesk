[alias]
	# Materialize one commit as ordinary uncommitted changes on its parent.
	review = "!f() { c=$(git rev-parse \"${1:?usage: git review <commit>}\") && git switch --detach \"$c^\" && git cherry-pick -n \"$c\" && git reset && echo \"$c\" > \"$(git rev-parse --git-dir)/REVIEW_COMMIT\"; }; f"

	# Materialize the cumulative branch/PR diff. With no arguments, compare HEAD
	# with the upstream remote's default branch. Optional: <base> [<target>].
	review-range = "!f() { set -e; test -z \"$(git status --porcelain)\" || { echo 'Working tree must be clean before review-range.' >&2; exit 1; }; target=\"${2:-HEAD}\"; if [ -n \"${1:-}\" ]; then base=\"$1\"; else remote=$(git config --get branch.$(git branch --show-current).remote || true); remote=\"${remote:-origin}\"; [ \"$remote\" = . ] && remote=origin; git fetch \"$remote\"; head=$(git symbolic-ref -q --short \"refs/remotes/$remote/HEAD\") || { echo \"Cannot determine $remote default branch.\" >&2; exit 1; }; base=\"$head\"; fi; target=$(git rev-parse \"$target\"); base=$(git rev-parse \"$base\"); mb=$(git merge-base \"$base\" \"$target\"); d=$(git rev-parse --git-dir); git symbolic-ref -q --short HEAD > \"$d/REVIEW_RETURN\" || git rev-parse HEAD > \"$d/REVIEW_RETURN\"; printf '%s\\n' \"$mb\" > \"$d/REVIEW_BASE\"; printf '%s\\n' \"$target\" > \"$d/REVIEW_TARGET\"; git switch --detach \"$mb\"; git diff --binary \"$mb\" \"$target\" | git apply --index; git reset; }; f"

	# Discard a materialized review and return to the branch/revision it started from.
	unreview = "!f() { set -e; if git symbolic-ref -q HEAD >/dev/null; then echo 'Not in review mode (HEAD is not detached).'; exit 1; fi; d=$(git rev-parse --git-dir); if [ -f \"$d/REVIEW_BASE\" ] && [ -f \"$d/REVIEW_TARGET\" ]; then git diff --name-only -z --diff-filter=A \"$(cat \"$d/REVIEW_BASE\")\" \"$(cat \"$d/REVIEW_TARGET\")\" | xargs -0 rm -f -- 2>/dev/null || true; elif [ -f \"$d/REVIEW_COMMIT\" ]; then git diff-tree -r --no-commit-id --diff-filter=A --name-only -z \"$(cat \"$d/REVIEW_COMMIT\")\" | xargs -0 rm -f -- 2>/dev/null || true; fi; git reset --hard; ret=$(cat \"$d/REVIEW_RETURN\" 2>/dev/null || true); rm -f \"$d/REVIEW_COMMIT\" \"$d/REVIEW_BASE\" \"$d/REVIEW_TARGET\" \"$d/REVIEW_RETURN\"; if [ -n \"$ret\" ]; then git switch -f \"$ret\" 2>/dev/null || git switch --detach \"$ret\"; else git switch -f -; fi; }; f"
